# IPTV Transcoder env example
# Copy ideas into: /var/packages/iptv-transcoder/var/env
# Values below match package/code defaults unless marked "production recommendation".

IPTV_TRANSCODER_HOST=0.0.0.0
IPTV_TRANSCODER_PORT=18096
IPTV_TRANSCODER_MANAGEMENT_PORT=18097
IPTV_TRANSCODER_PUBLIC_BASE_URL=http://NAS_IP:18096
IPTV_TRANSCODER_FFMPEG=/var/packages/Jellyfin/target/bin/ffmpeg
IPTV_TRANSCODER_FFPROBE=/var/packages/Jellyfin/target/bin/ffprobe
IPTV_TRANSCODER_QSV_DEVICE=/dev/dri/renderD128
IPTV_TRANSCODER_ALLOWED_UPSTREAMS=192.168.1.1:7088
IPTV_TRANSCODER_HARDWARE_ONLY=1

# Package/code defaults:
IPTV_TRANSCODER_MAX_TRANSCODES=5
IPTV_TRANSCODER_IDLE_TIMEOUT=10
# Production recommendation on UHD630 shared with Jellyfin:
# IPTV_TRANSCODER_MAX_TRANSCODES=1
# IPTV_TRANSCODER_IDLE_TIMEOUT=90

IPTV_TRANSCODER_GLOBAL_QUALITY=23
IPTV_TRANSCODER_GLOBAL_QUALITY_4K=24
IPTV_TRANSCODER_QSV_LOW_POWER_H264=1
IPTV_TRANSCODER_QSV_LOW_POWER_720P_LOW_BITRATE=2500k
IPTV_TRANSCODER_QSV_LOW_POWER_720P_LOW_MAXRATE=3000k
IPTV_TRANSCODER_QSV_LOW_POWER_720P_LOW_BUFSIZE=6000k
IPTV_TRANSCODER_QSV_LOW_POWER_720P_MEDIUM_BITRATE=3500k
IPTV_TRANSCODER_QSV_LOW_POWER_720P_MEDIUM_MAXRATE=4000k
IPTV_TRANSCODER_QSV_LOW_POWER_720P_MEDIUM_BUFSIZE=8000k
IPTV_TRANSCODER_QSV_LOW_POWER_720P_HIGH_BITRATE=5000k
IPTV_TRANSCODER_QSV_LOW_POWER_720P_HIGH_MAXRATE=6000k
IPTV_TRANSCODER_QSV_LOW_POWER_720P_HIGH_BUFSIZE=12000k
IPTV_TRANSCODER_QSV_LOW_POWER_1080P_LOW_BITRATE=4500k
IPTV_TRANSCODER_QSV_LOW_POWER_1080P_LOW_MAXRATE=5000k
IPTV_TRANSCODER_QSV_LOW_POWER_1080P_LOW_BUFSIZE=10000k
IPTV_TRANSCODER_QSV_LOW_POWER_1080P_MEDIUM_BITRATE=6000k
IPTV_TRANSCODER_QSV_LOW_POWER_1080P_MEDIUM_MAXRATE=7000k
IPTV_TRANSCODER_QSV_LOW_POWER_1080P_MEDIUM_BUFSIZE=14000k
IPTV_TRANSCODER_QSV_LOW_POWER_1080P_HIGH_BITRATE=8000k
IPTV_TRANSCODER_QSV_LOW_POWER_1080P_HIGH_MAXRATE=9000k
IPTV_TRANSCODER_QSV_LOW_POWER_1080P_HIGH_BUFSIZE=18000k
IPTV_TRANSCODER_QSV_LOW_POWER_2K_LOW_BITRATE=7000k
IPTV_TRANSCODER_QSV_LOW_POWER_2K_LOW_MAXRATE=8000k
IPTV_TRANSCODER_QSV_LOW_POWER_2K_LOW_BUFSIZE=16000k
IPTV_TRANSCODER_QSV_LOW_POWER_2K_MEDIUM_BITRATE=9000k
IPTV_TRANSCODER_QSV_LOW_POWER_2K_MEDIUM_MAXRATE=10000k
IPTV_TRANSCODER_QSV_LOW_POWER_2K_MEDIUM_BUFSIZE=20000k
IPTV_TRANSCODER_QSV_LOW_POWER_2K_HIGH_BITRATE=12000k
IPTV_TRANSCODER_QSV_LOW_POWER_2K_HIGH_MAXRATE=14000k
IPTV_TRANSCODER_QSV_LOW_POWER_2K_HIGH_BUFSIZE=28000k
IPTV_TRANSCODER_QSV_LOW_POWER_4K_LOW_BITRATE=14000k
IPTV_TRANSCODER_QSV_LOW_POWER_4K_LOW_MAXRATE=16000k
IPTV_TRANSCODER_QSV_LOW_POWER_4K_LOW_BUFSIZE=32000k
IPTV_TRANSCODER_QSV_LOW_POWER_4K_MEDIUM_BITRATE=18000k
IPTV_TRANSCODER_QSV_LOW_POWER_4K_MEDIUM_MAXRATE=20000k
IPTV_TRANSCODER_QSV_LOW_POWER_4K_MEDIUM_BUFSIZE=40000k
IPTV_TRANSCODER_QSV_LOW_POWER_4K_HIGH_BITRATE=25000k
IPTV_TRANSCODER_QSV_LOW_POWER_4K_HIGH_MAXRATE=28000k
IPTV_TRANSCODER_QSV_LOW_POWER_4K_HIGH_BUFSIZE=56000k
IPTV_TRANSCODER_AUDIO_BITRATE=128k

# Auto HLS target segment duration. Actual segment length/GOP is aligned to source fps.
IPTV_TRANSCODER_HLS_TIME=2
# Auto HLS GOP upper bound. 25fps -> 50 GOP, 50fps -> 100 GOP by default.
IPTV_TRANSCODER_HLS_GOP=100
IPTV_TRANSCODER_STARTUP_PROBE_SECONDS=0.2
IPTV_TRANSCODER_FFMPEG_STOP_TIMEOUT=1.5
IPTV_TRANSCODER_FFPROBE_TIMEOUT=20
IPTV_TRANSCODER_FFPROBE_ANALYZEDURATION=10000000
IPTV_TRANSCODER_FFPROBE_PROBESIZE=20000000

# 8-bit HDR/HLG QSV VPP tonemap only (not used by 10-bit OpenCL bt2390 path).
# If SDR output looks gray, try brightness=16 or 20; if too bright, lower toward 8 or below.
IPTV_TRANSCODER_HDR_VPP_BRIGHTNESS=8
IPTV_TRANSCODER_HDR_VPP_CONTRAST=1
